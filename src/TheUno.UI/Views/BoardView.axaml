<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TheUno.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="TheUno.UI.Views.BoardView"
             x:DataType="vm:BoardViewModel"
             x:CompileBindings="True"
             RenderOptions.BitmapInterpolationMode="None">

    <!-- RenderOptions sin interpolación: las cartas son pixel art y deben verse nítidas al escalarse -->

    <Design.DataContext>
        <vm:BoardViewModel />
    </Design.DataContext>

    <UserControl.DataTemplates>
        <!-- Carta reutilizable: muestra la imagen correspondiente con esquinas ligeramente redondeadas -->
        <DataTemplate DataType="vm:CardViewModel">
            <!-- El borde exterior dibuja la sombra y el contorno; el interior recorta la imagen
                 (si fuera uno solo, el recorte también cortaría la sombra) -->
            <Border Classes="card" CornerRadius="4">
                <Border CornerRadius="4" ClipToBounds="True">
                    <Panel>
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                        <!-- Capa negra que oscurece la carta cuando no es el turno de su jugador -->
                        <Border Classes="cardShade" />
                    </Panel>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- Fondo de la mesa -->
    <UserControl.Background>
        <ImageBrush Source="avares://TheUno.UI/Assets/Backgrounds/table_8bit.jpg" Stretch="UniformToFill" />
    </UserControl.Background>

    <UserControl.Styles>
        <Style Selector="Border.playerZone">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="12" />
            <!-- Borde transparente del mismo grosor que el del turno activo para que nada se mueva al cambiar -->
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Turno activo: marco y nombre en amarillo; las manos de los demás se oscurecen -->
        <Style Selector="Border.playerZone.active">
            <Setter Property="BorderBrush" Value="#E6B400" />
            <Setter Property="Background" Value="#55000000" />
        </Style>
        <Style Selector="Border.cardShade">
            <Setter Property="Background" Value="#73000000" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ItemsControl:disabled Border.cardShade">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Textos estilo 8 bits: fuente pixel y sombra dura sin desenfoque -->
        <Style Selector="TextBlock.pixelText">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.playerName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Color="Black" Opacity="1" />
            </Setter>
        </Style>
        <!-- Va después de pixelText para que el amarillo del turno activo gane sobre el blanco -->
        <Style Selector="Border.playerZone.active TextBlock.playerName">
            <Setter Property="Foreground" Value="#E6B400" />
        </Style>
        <Style Selector="TextBlock.zoneLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Color="Black" Opacity="1" />
            </Setter>
        </Style>

        <!-- Pila de robo interactiva -->
        <Style Selector="Button.drawPile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.drawPile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.drawPile:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.drawPile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Sombra base de las cartas -->
        <Style Selector="Border.card">
            <Setter Property="BoxShadow" Value="0 2 6 0 #66000000" />
        </Style>

        <!-- Hover: el efecto va en el contenedor de cada carta de la mano (hijo directo del ItemsControl)
             y no en la carta, porque las cartas laterales están dentro de un control que las gira
             y recorta todo lo que sale de su espacio. -->
        <Style Selector="ItemsControl > ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Solo en la mano del jugador en turno: contorno amarillo, se dibuja encima de sus
             vecinas y se mueve hacia el centro de la mesa -->
        <Style Selector="Border.playerZone.active ItemsControl > ContentPresenter:pointerover">
            <Setter Property="BoxShadow" Value="0 0 0 4 #E6B400, 0 6 10 0 #99000000" />
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <!-- Sin esto el panel horizontal estira el contenedor a toda la altura y el contorno queda más alto que la carta -->
        <Style Selector="ItemsControl.bottomHand > ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.playerZone.active ItemsControl.bottomHand > ContentPresenter:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px, -14px)" />
        </Style>
        <!-- Manos laterales: +X apunta al centro (la del Jugador 3 está girada 180°) -->
        <Style Selector="Border.playerZone.active ItemsControl.sideHand > ContentPresenter:pointerover">
            <Setter Property="RenderTransform" Value="translate(14px, 0px)" />
        </Style>

        <!-- Tamaños de carta por zona -->
        <Style Selector="ItemsControl.bottomHand Border.card">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="126" />
        </Style>
        <Style Selector="ItemsControl.sideHand Border.card">
            <Setter Property="Width" Value="61" />
            <Setter Property="Height" Value="96" />
        </Style>

        <!-- Flecha de dirección: se refleja cuando el sentido es antihorario -->
        <Style Selector="Canvas.directionArrow">
            <Setter Property="RenderTransform" Value="scaleX(1)" />
        </Style>
        <Style Selector="Canvas.directionArrow.counterClockwise">
            <Setter Property="RenderTransform" Value="scaleX(-1)" />
        </Style>

        <!-- Botón para regresar al menú y botones de la alerta (base en Styles/PixelStyles.axaml) -->
        <Style Selector="Button.backButton">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="20,20,0,0" />
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="0" Color="Black" Opacity="1" />
            </Setter>
        </Style>
        <Style Selector="Button.backButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#444444" />
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MinWidth" Value="260" />
        </Style>
        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="#0020FF" />
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4060FF" />
        </Style>
        <Style Selector="Button.confirm">
            <Setter Property="Background" Value="#FF0000" />
        </Style>
        <Style Selector="Button.confirm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF4040" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="240,*,240">

            <!-- Regresar al menú (pide confirmación porque se pierde la partida) -->
            <Button Grid.Row="0" Grid.Column="0"
                    Classes="pixelButton backButton"
                    Content="← MENU"
                    Command="{Binding RequestExitCommand}" />

            <!-- Jugador 2 (Izquierda) -->
            <Border Grid.Row="1" Grid.Column="0" Classes="playerZone"
                    Classes.active="{Binding Player2.IsActive}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="pixelText playerName" Text="{Binding Player2.Name}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Classes="sideHand" ItemsSource="{Binding Player2.Hand}"
                                      IsEnabled="{Binding Player2.IsActive}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="-30" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CardViewModel">
                                    <LayoutTransformControl LayoutTransform="rotate(90deg)">
                                        <ContentControl Content="{Binding}" />
                                    </LayoutTransformControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Jugador 3 (Derecha) -->
            <Border Grid.Row="1" Grid.Column="2" Classes="playerZone"
                    Classes.active="{Binding Player3.IsActive}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="pixelText playerName" Text="{Binding Player3.Name}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <!-- Girado 180° con cartas a 90°: cada carta queda orientada hacia el Jugador 3
                             y la franja visible es la parte superior, donde está el número -->
                        <ItemsControl Classes="sideHand" ItemsSource="{Binding Player3.Hand}"
                                      IsEnabled="{Binding Player3.IsActive}"
                                      VerticalAlignment="Top"
                                      RenderTransform="rotate(180deg)">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="-30" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CardViewModel">
                                    <LayoutTransformControl LayoutTransform="rotate(90deg)">
                                        <ContentControl Content="{Binding}" />
                                    </LayoutTransformControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Indicadores: color activo y dirección del turno, arriba al centro -->
            <StackPanel Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Spacing="48">
                <StackPanel>
                    <Ellipse Width="40" Height="40"
                             Fill="{Binding ActiveColorBrush}"
                             Stroke="White"
                             StrokeThickness="3"
                             HorizontalAlignment="Center" />
                    <TextBlock Classes="zoneLabel" Text="Color activo" />
                </StackPanel>

                <StackPanel>
                    <Viewbox Width="42" Height="42" HorizontalAlignment="Center">
                        <Canvas Classes="directionArrow"
                                Classes.counterClockwise="{Binding IsCounterClockwise}"
                                Width="60" Height="60">
                            <Path Data="M 30,6 A 24,24 0 1 1 6,30"
                                  Stroke="White"
                                  StrokeThickness="4"
                                  StrokeLineCap="Round" />
                            <Path Data="M 0,32 L 6,21 L 12,32 Z" Fill="White" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Classes="zoneLabel" Text="{Binding DirectionText}" />
                </StackPanel>
            </StackPanel>

            <!-- Zona Central: pila de robo y pila de descarte -->
            <Grid Grid.Row="1" Grid.Column="1"
                  ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="36"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <!-- Pila de robo -->
                <StackPanel Grid.Column="0">
                    <Button Classes="drawPile" ToolTip.Tip="Robar una carta">
                        <Border Width="105" Height="165" CornerRadius="6" ClipToBounds="True">
                            <Image Source="{Binding DrawPileImage}" Stretch="UniformToFill" />
                        </Border>
                    </Button>
                    <TextBlock Classes="zoneLabel" Text="Robar" />
                </StackPanel>

                <!-- Pila de descarte -->
                <StackPanel Grid.Column="1">
                    <Panel Width="105" Height="165">
                        <Rectangle Stroke="#99FFFFFF"
                                   StrokeThickness="2"
                                   StrokeDashArray="4,3"
                                   RadiusX="6" RadiusY="6" />
                        <Border CornerRadius="6" ClipToBounds="True" BoxShadow="0 4 12 0 #88000000">
                            <Image Source="{Binding TopDiscard.Image}" Stretch="UniformToFill" />
                        </Border>
                    </Panel>
                    <TextBlock Classes="zoneLabel" Text="Descarte" />
                </StackPanel>
            </Grid>

            <!-- Jugador 1 (Abajo) -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Classes="playerZone"
                    Classes.active="{Binding Player1.IsActive}"
                    Height="220">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="pixelText playerName" Text="{Binding Player1.Name}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Classes="bottomHand" ItemsSource="{Binding Player1.Hand}"
                                      IsEnabled="{Binding Player1.IsActive}"
                                      Padding="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Alerta para salir: capa oscura sobre todo el tablero (bloquea los clics) con el aviso al centro -->
        <Panel IsVisible="{Binding IsExitDialogOpen}" Background="#B3000000">
            <Border Background="#3A2213"
                    BorderBrush="Black"
                    BorderThickness="6"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="10 10 0 0 #000000">
                <StackPanel Spacing="40">
                    <TextBlock Classes="pixelText"
                               FontSize="18"
                               LineHeight="34"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect OffsetX="3" OffsetY="3" BlurRadius="0" Color="Black" Opacity="1" />
                        </TextBlock.Effect>
                        <Run Text="¡¿Estás seguro que quieres salir," />
                        <LineBreak />
                        <Run Text="estás en pleno juego?!" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="32">
                        <Button Classes="pixelButton dialogButton cancel"
                                Content="Cancelar"
                                Command="{Binding CancelExitCommand}" />
                        <Button Classes="pixelButton dialogButton confirm"
                                Content="Sí, estoy seguro"
                                Command="{Binding ConfirmExitCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
