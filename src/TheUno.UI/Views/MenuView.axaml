<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TheUno.UI.ViewModels"
             xmlns:controls="using:TheUno.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="TheUno.UI.Views.MenuView"
             x:DataType="vm:MenuViewModel"
             x:CompileBindings="True"
             RenderOptions.BitmapInterpolationMode="None">

    <Design.DataContext>
        <vm:MenuViewModel />
    </Design.DataContext>

    <!-- Fondo del menú: la taberna con los tres jugadores -->
    <UserControl.Background>
        <ImageBrush Source="avares://TheUno.UI/Assets/Backgrounds/menu_8bit.jpg"
                    Stretch="UniformToFill"
                    AlignmentX="Left" />
    </UserControl.Background>

    <UserControl.Styles>
        <!-- El estilo base de Button.pixelButton está en Styles/PixelStyles.axaml (compartido con el tablero) -->

        <!-- Colores tomados de la paleta de las cartas -->
        <Style Selector="Button.start">
            <Setter Property="Background" Value="#FF0000" />
        </Style>
        <Style Selector="Button.start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF4040" />
        </Style>
        <Style Selector="Button.history">
            <Setter Property="Background" Value="#0020FF" />
        </Style>
        <Style Selector="Button.history:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4060FF" />
        </Style>
        <Style Selector="Button.create">
            <Setter Property="Background" Value="#1FB800" />
        </Style>
        <Style Selector="Button.create:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33DB0F" />
        </Style>
        <Style Selector="Button.join">
            <Setter Property="Background" Value="#E6B400" />
        </Style>
        <Style Selector="Button.join:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFCC1A" />
        </Style>
        <Style Selector="Button.back">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style Selector="Button.back:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#444444" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Título amarillo con contorno blanco, arriba al centro -->
        <controls:OutlinedText Text="THE UNO"
                               FontSize="84"
                               Fill="#E6B400"
                               Stroke="White"
                               StrokeThickness="5"
                               ShadowOffset="8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,36,0,0" />

        <!-- Menú del lado derecho, sobre la barra, sin tapar a los jugadores -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="440"
                    Margin="0,80,48,0"
                    Spacing="32"
                    IsVisible="{Binding !IsPlayOptionsOpen}">
            <Button Classes="pixelButton start"
                    Content="INICIAR JUEGO"
                    Command="{Binding ShowPlayOptionsCommand}" />
            <Button Classes="pixelButton history"
                    Content="VER HISTORIAL"
                    Command="{Binding ShowHistoryCommand}" />
        </StackPanel>

        <!-- Al picar "Iniciar juego": crear la partida en esta compu o unirse a la de otra -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="440"
                    Margin="0,80,48,0"
                    Spacing="32"
                    IsVisible="{Binding IsPlayOptionsOpen}">
            <Button Classes="pixelButton create"
                    Content="CREAR PARTIDA"
                    Command="{Binding CreateGameCommand}" />
            <Button Classes="pixelButton join"
                    Content="UNIRSE A PARTIDA"
                    Command="{Binding JoinGameCommand}" />
            <Button Classes="pixelButton back"
                    Content="VOLVER"
                    Command="{Binding HidePlayOptionsCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
