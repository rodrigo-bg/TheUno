<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TheUno.UI.ViewModels"
             xmlns:controls="using:TheUno.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="TheUno.UI.Views.StatsView"
             x:DataType="vm:StatsViewModel"
             x:CompileBindings="True"
             RenderOptions.BitmapInterpolationMode="None">

    <Design.DataContext>
        <vm:StatsViewModel />
    </Design.DataContext>

    <!-- Mismo fondo que el menú -->
    <UserControl.Background>
        <ImageBrush Source="avares://TheUno.UI/Assets/Backgrounds/menu_8bit.jpg"
                    Stretch="UniformToFill"
                    AlignmentX="Left" />
    </UserControl.Background>

    <UserControl.Styles>
        <!-- Botón para regresar al menú (base en Styles/PixelStyles.axaml), igual al del tablero -->
        <Style Selector="Button.backButton">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="20,20,0,0" />
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="0" Color="Black" Opacity="1" />
            </Setter>
        </Style>
        <Style Selector="Button.backButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#444444" />
        </Style>

        <!-- Tabla: encabezados amarillos, renglones blancos y el primer lugar en amarillo -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#E6B400" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.row.first TextBlock.cell">
            <Setter Property="Foreground" Value="#E6B400" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="#66000000" />
            <Setter Property="BorderThickness" Value="0,3,0,0" />
        </Style>
        <!-- Cuadros de partidas y bitácora: mismo estilo que la tabla -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#3A2213" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Height" Value="260" />
            <Setter Property="BoxShadow" Value="10 10 0 0 #000000" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.turn">
            <Setter Property="Foreground" Value="#E6B400" />
        </Style>
        <Style Selector="TextBlock.message">
            <Setter Property="Foreground" Value="#FF4040" />
        </Style>

        <!-- Lista de partidas: sin el fondo de Fluent; la elegida se marca en amarillo -->
        <Style Selector="ListBox.matches">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.matches ListBoxItem">
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.matches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="ListBox.matches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66E6B400" />
        </Style>

        <!-- Servidor del historial: campo para la IP y botón para recargar -->
        <Style Selector="TextBox.serverBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Width" Value="230" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.serverBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="TextBox.serverBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#E6B400" />
        </Style>
        <Style Selector="TextBox.serverBox:pointerover, TextBox.serverBox:focus">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.reloadButton">
            <Setter Property="Background" Value="#0020FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.reloadButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4060FF" />
        </Style>

        <Style Selector="TextBlock.header, TextBlock.cell">
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Color="Black" Opacity="1" />
            </Setter>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Capa oscura para que la tabla se lea bien sobre la taberna -->
        <Panel Background="#99000000" />

        <!-- Con la ventana chica, el contenido se puede desplazar hacia abajo -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,24"
                    Spacing="28">
            <controls:OutlinedText Text="HISTORIAL"
                                   FontSize="56"
                                   Fill="#E6B400"
                                   Stroke="White"
                                   StrokeThickness="4"
                                   ShadowOffset="6"
                                   HorizontalAlignment="Center" />

            <!-- De qué compu se lee el historial. Se puede escribir otra IP y recargar (Enter también) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Classes="header" Text="SERVIDOR" VerticalAlignment="Center" />
                <TextBox Classes="serverBox" Text="{Binding ServerHost}" Watermark="192.168.1.50">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ChangeServerCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="pixelButton reloadButton"
                        Content="RECARGAR"
                        Command="{Binding ChangeServerCommand}" />
            </StackPanel>

            <Border Background="#3A2213"
                    BorderBrush="Black"
                    BorderThickness="6"
                    Padding="24"
                    BoxShadow="10 10 0 0 #000000">
                <StackPanel>
                    <!-- Encabezados: mismas columnas que los renglones -->
                    <Grid ColumnDefinitions="40,200,140,140,140,160" Margin="0,0,0,14">
                        <TextBlock Grid.Column="0" Classes="header" Text="#" />
                        <TextBlock Grid.Column="1" Classes="header" Text="JUGADOR" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Classes="header" Text="PARTIDAS" />
                        <TextBlock Grid.Column="3" Classes="header" Text="VICTORIAS" />
                        <TextBlock Grid.Column="4" Classes="header" Text="DERROTAS" />
                        <TextBlock Grid.Column="5" Classes="header" Text="% VICTORIAS" />
                    </Grid>

                    <!-- Aviso cuando la API no responde o mientras carga -->
                    <TextBlock Classes="cell"
                               Margin="0,14"
                               Foreground="#FF4040"
                               IsVisible="{Binding HasStatusMessage}"
                               Text="{Binding StatusMessage}" />

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LeaderboardRow">
                                <Border Classes="row" Classes.first="{Binding IsFirst}">
                                    <Grid ColumnDefinitions="40,200,140,140,140,160">
                                        <TextBlock Grid.Column="0" Classes="cell" Text="{Binding Position}" />
                                        <TextBlock Grid.Column="1" Classes="cell name" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Classes="cell" Text="{Binding MatchesPlayed}" />
                                        <TextBlock Grid.Column="3" Classes="cell" Text="{Binding MatchesWon}" />
                                        <TextBlock Grid.Column="4" Classes="cell" Text="{Binding MatchesLost}" />
                                        <TextBlock Grid.Column="5" Classes="cell" Text="{Binding WinRateText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Partidas terminadas (izquierda) y bitácora de la partida elegida (derecha) -->
            <Grid ColumnDefinitions="340,20,*" Width="880">
                <Border Grid.Column="0" Classes="panel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="header" Text="PARTIDAS" Margin="0,0,0,12" />
                        <ListBox Classes="matches"
                                 ItemsSource="{Binding Matches}"
                                 SelectedItem="{Binding SelectedMatch}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:MatchRow">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="small">
                                            <Run Text="{Binding DateText}" />
                                            <Run Text="  GANÓ " />
                                            <Run Foreground="#E6B400" Text="{Binding WinnerName}" />
                                        </TextBlock>
                                        <TextBlock Classes="small" Foreground="#CCCCCC" Text="{Binding DetailText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Classes="panel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="header" Text="BITÁCORA" Margin="0,0,0,12" />
                        <TextBlock DockPanel.Dock="Top"
                                   Classes="small message"
                                   IsVisible="{Binding HasLogMessage}"
                                   Text="{Binding LogMessage}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:LogRow">
                                        <Grid ColumnDefinitions="48,*" Margin="0,0,8,8">
                                            <TextBlock Grid.Column="0" Classes="small turn" Text="{Binding TurnText}" />
                                            <TextBlock Grid.Column="1" Classes="small" Text="{Binding Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- Va después del ScrollViewer para quedar encima: el ScrollViewer ocupa toda la pantalla
             y, si el botón quedara debajo, se llevaría los clics -->
        <Button Classes="pixelButton backButton"
                Content="← MENU"
                Command="{Binding BackToMenuCommand}" />
    </Panel>
</UserControl>
