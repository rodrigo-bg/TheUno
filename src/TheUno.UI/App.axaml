<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheUno.UI.App"
             RequestedThemeVariant="Dark">
    <!-- Tema oscuro fijo: así los controles de Fluent (tooltips, barras de desplazamiento) combinan
         con el estilo 8 bits sin importar si Windows está en modo claro u oscuro -->

    <Application.Resources>
        <!-- Fuente pixel art (Press Start 2P, licencia OFL en Assets/Fonts/OFL.txt) -->
        <FontFamily x:Key="PixelFont">avares://TheUno.UI/Assets/Fonts#Press Start 2P</FontFamily>
        <!-- Los controles de Fluent (botones, tooltips, etc.) también usan la fuente pixel -->
        <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="PixelFont" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TheUno.UI/Styles/PixelStyles.axaml" />
    </Application.Styles>
</Application>